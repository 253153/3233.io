# Copy to `.env` in the repository root before `docker compose up`.
# Docker Compose reads `.env` automatically; do not commit `.env`.

# Required — at least 32 bytes. Generate: openssl rand -hex 32
JWT_SECRET=

# When the app sits behind nginx (recommended), keep this so rate limits
# use the client IP from X-Forwarded-For. Set to 0 only if nothing proxies
# in front of the container.
TRUST_FORWARDED_FOR=1

# Optional (defaults match docker-compose.yml)
# MESSAGE_TTL_DAYS=14
# JWT_EXPIRY_SEC=604800
# MAX_MESSAGE_BYTES=262144
